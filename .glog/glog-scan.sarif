            {
              "id": "d14cf69b-61fa-3465-8846-3bcf9c0445a3",
              "name": "resources.rules.glog-python.python-cleartext-credential-form-get",
              "shortDescription": {
                "text": "Opengrep Finding: resources.rules.glog-python.python-cleartext-credential-form-get"
              },
              "fullDescription": {
                "text": "A sign-in form carries a password field and submits with the GET method, so the credentials are placed in the URL query string. URLs are recorded in browser history, bookmarks, server and proxy access logs, and are forwarded to other sites in the Referer header. Submit credential forms with POST over HTTPS instead."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
              },
              "help": {
                "text": "A sign-in form carries a password field and submits with the GET method, so the credentials are placed in the URL query string. URLs are recorded in browser history, bookmarks, server and proxy access logs, and are forwarded to other sites in the Referer header. Submit credential forms with POST over HTTPS instead.",
                "markdown": "A sign-in form carries a password field and submits with the GET method, so the credentials are placed in the URL query string. URLs are recorded in browser history, bookmarks, server and proxy access logs, and are forwarded to other sites in the Referer header. Submit credential forms with POST over HTTPS instead.\n\n<b>References:</b>\n - [https://cwe.mitre.org/data/definitions/319.html](https://cwe.mitre.org/data/definitions/319.html)\n"
              },
              "properties": {
                "cwe": [
