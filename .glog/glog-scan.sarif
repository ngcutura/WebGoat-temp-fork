            {
              "id": "c4287793-6ce7-3d24-becf-abace22ee0d1",
              "name": "resources.rules.glog-python.python-cleartext-credential-form-get",
              "shortDescription": {
                "text": "Opengrep Finding: resources.rules.glog-python.python-cleartext-credential-form-get"
              },
              "fullDescription": {
                "text": "A sign-in form carries a password field and submits with the GET method, so the credentials are placed in the URL query string. URLs are recorded in browser history, bookmarks, server and proxy access logs, and are forwarded to other sites in the Referer header. Submit credential forms with POST over HTTPS instead."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
              },
              "help": {
                "text": "A sign-in form carries a password field and submits with the GET method, so the credentials are placed in the URL query string. URLs are recorded in browser history, bookmarks, server and proxy access logs, and are forwarded to other sites in the Referer header. Submit credential forms with POST over HTTPS instead.",
